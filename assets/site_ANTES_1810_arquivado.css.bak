/* AxisCopic · axiscopic.com — um arquivo de estilo para PT e EN (o gerador reaproveita).
   Mundo visual deliberado e único: a tela é noir (o canal) e o papel é o dossiê (o produto). */
:root {
  --noir: #14110D;
  --noir-2: #1B1712;
  --noir-3: #262019;
  --ouro: #FFBF00;
  --ouro-claro: #E6C568;
  --ouro-papel: #7E5E00;   /* ouro legível sobre papel: 5,6:1 */
  --papel: #F2ECDF;
  --papel-2: #E7DECB;
  --tinta: #1E1A14;
  --tinta-2: #5A5143;
  --cinza: #A99F8E;        /* neutro puxado para o ouro, 7,4:1 sobre noir */
  --linha: rgba(242, 236, 223, .13);
  --linha-papel: rgba(30, 26, 20, .16);
  --display: "Playfair Display", Georgia, "Times New Roman", serif;
  --texto: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "Cascadia Mono", Consolas, monospace;
  --larg: 1160px;
  --gutter: clamp(16px, 4vw, 40px);
  color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--noir);
  color: var(--papel);
  font: 400 17px/1.6 var(--texto);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; }
h1, h2, h3 { font-family: var(--display); font-weight: 800; line-height: 1.08; margin: 0; text-wrap: balance; letter-spacing: -.01em; }
p { margin: 0; }
:focus-visible { outline: 2px solid var(--ouro); outline-offset: 3px; border-radius: 2px; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

.wrap { max-width: var(--larg); margin: 0 auto; padding: 0 var(--gutter); }
.rotulo {
  font: 500 12px/1.3 var(--mono);
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--ouro);
}
.papel .rotulo { color: var(--ouro-papel); }
.secao { padding: clamp(72px, 10vw, 128px) 0; }
.secao-cab { display: grid; gap: 16px; max-width: 760px; margin-bottom: clamp(36px, 5vw, 56px); }
.secao-cab h2 { font-size: clamp(32px, 4.6vw, 54px); }
.secao-cab .lead { color: var(--cinza); font-size: clamp(17px, 1.6vw, 19px); max-width: 62ch; }
.papel { background: var(--papel); color: var(--tinta); }
.papel .secao-cab .lead { color: var(--tinta-2); }

/* ── cabeçalho ─────────────────────────────────────────── */
.topo {
  position: sticky; top: 0; z-index: 20;
  background: rgba(20, 17, 13, .86);
  backdrop-filter: saturate(140%) blur(10px);
  -webkit-backdrop-filter: saturate(140%) blur(10px);
  border-bottom: 1px solid var(--linha);
}
.topo .wrap { display: flex; align-items: center; gap: 24px; height: 64px; }
.marca { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.marca svg { width: 30px; height: 30px; flex: none; }
.marca b { font: 800 19px/1 var(--display); letter-spacing: .01em; }
.marca small { font: 500 11px/1 var(--mono); letter-spacing: .14em; color: var(--ouro); text-transform: uppercase; }
.nav { display: flex; gap: 22px; margin-left: auto; }
.nav a { font-size: 14px; text-decoration: none; color: var(--cinza); }
.nav a:hover { color: var(--papel); }
.idioma { display: flex; border: 1px solid var(--linha); border-radius: 999px; overflow: hidden; font: 500 12px/1 var(--mono); }
.idioma a, .idioma span { padding: 7px 10px; text-decoration: none; }
.idioma span { background: var(--papel); color: var(--noir); }
.idioma a { color: var(--cinza); }
.idioma a:hover { color: var(--papel); }

/* ── hero ──────────────────────────────────────────────── */
.hero { position: relative; padding: clamp(48px, 8vw, 104px) 0 clamp(64px, 8vw, 112px); overflow: hidden; }
.hero::before {
  content: ""; position: absolute; inset: 0;
  background:
    radial-gradient(60% 70% at 78% 40%, rgba(255, 191, 0, .13), transparent 70%),
    repeating-linear-gradient(90deg, rgba(242, 236, 223, .035) 0 1px, transparent 1px 120px);
  pointer-events: none;
}
.hero .wrap { position: relative; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
.hero h1 { font-size: clamp(42px, 6.6vw, 84px); font-weight: 900; margin: 18px 0 24px; }
.hero h1 em { font-style: italic; font-weight: 800; color: var(--ouro); }
.hero .lead { font-size: clamp(18px, 1.7vw, 20px); color: #D9D1C1; max-width: 54ch; margin-bottom: 32px; }

.pasta { position: relative; aspect-ratio: 1 / 1.08; }
.pasta figure { position: absolute; margin: 0; width: 72%; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .7), 0 0 0 1px rgba(0, 0, 0, .3); }
.pasta figure img { width: 100%; height: auto; }
.pasta .fundo { right: 0; top: 4%; transform: rotate(4deg); filter: brightness(.82); }
.pasta .frente { left: 2%; top: 9%; transform: rotate(-3.5deg); }
.pasta .etiqueta {
  position: absolute; left: 0; bottom: 3%;
  background: var(--ouro); color: var(--noir);
  font: 600 12px/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase;
  padding: 10px 14px; transform: rotate(-3.5deg);
}

/* ── formulário de captura ─────────────────────────────── */
.captura { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; max-width: 560px; }
.captura input {
  min-width: 0; height: 56px; padding: 0 18px;
  font: 400 17px var(--texto); color: var(--papel);
  background: var(--noir-3); border: 1px solid rgba(242, 236, 223, .22); border-radius: 4px;
}
.captura input::placeholder { color: #8C8373; }
.captura input:focus { outline: none; border-color: var(--ouro); box-shadow: 0 0 0 3px rgba(255, 191, 0, .25); }
.botao {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  height: 56px; padding: 0 24px;
  font: 700 16px/1 var(--texto); color: var(--noir); text-decoration: none;
  background: var(--ouro); border: 0; border-radius: 4px; cursor: pointer;
  transition: background .2s, transform .2s;
}
.botao:hover { background: #FFCD33; }
.botao:active { transform: translateY(1px); }
.botao.fantasma { background: transparent; color: var(--papel); border: 1px solid rgba(242, 236, 223, .3); }
.botao.fantasma:hover { border-color: var(--papel); }
.captura .micro { grid-column: 1 / -1; font-size: 14px; color: var(--cinza); }
.captura .retorno { grid-column: 1 / -1; font: 500 13px/1.5 var(--mono); color: var(--ouro-claro); min-height: 0; }
.captura .retorno:empty { display: none; }
.papel .captura input { background: #FFFDF8; color: var(--tinta); border-color: var(--linha-papel); }
.papel .captura .micro { color: var(--tinta-2); }
.papel .captura .retorno { color: var(--ouro-papel); }

/* ── faixa dos números ─────────────────────────────────── */
.numeros { border-top: 1px solid var(--linha); border-bottom: 1px solid var(--linha); background: var(--noir-2); }
.numeros .wrap { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.numero { padding: clamp(28px, 4vw, 44px) clamp(16px, 2.6vw, 32px); border-left: 1px solid var(--linha); display: grid; gap: 10px; align-content: start; }
.numero:first-child { border-left: 0; padding-left: 0; }
.numero strong { font: 900 clamp(44px, 5vw, 64px)/1 var(--display); color: var(--ouro); font-variant-numeric: lining-nums; white-space: nowrap; }
.numero span { color: #D9D1C1; font-size: 16px; max-width: 30ch; }
.numero cite { font: 400 12px/1.4 var(--mono); color: var(--cinza); font-style: normal; letter-spacing: .02em; }
.numeros .moral { grid-column: 1 / -1; border-top: 1px solid var(--linha); padding: 22px 0; font: italic 600 clamp(19px, 2vw, 24px)/1.35 var(--display); color: var(--papel); }

/* ── a ficha grátis ────────────────────────────────────── */
.ficha .wrap { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(36px, 6vw, 88px); align-items: start; }
.ficha .secao-cab { margin-bottom: 32px; }
.perguntas { list-style: none; margin: 0; padding: 0; counter-reset: p; border-top: 1px solid var(--linha); }
.perguntas li { counter-increment: p; display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 16px; padding: 22px 0; border-bottom: 1px solid var(--linha); align-items: baseline; }
.perguntas li::before { content: counter(p, decimal-leading-zero); font: 900 34px/1 var(--display); color: var(--ouro); }
.perguntas b { display: block; font: 700 clamp(19px, 2vw, 23px)/1.3 var(--display); }
.perguntas span { display: block; margin-top: 6px; color: var(--cinza); font-size: 15px; }

/* ── o método ──────────────────────────────────────────── */
.metodo-grade { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; background: var(--linha-papel); border: 1px solid var(--linha-papel); }
.metodo-grade > div { background: var(--papel); padding: clamp(22px, 2.6vw, 32px); display: grid; gap: 10px; align-content: start; grid-column: span 2; }
.metodo-grade > div:nth-child(4), .metodo-grade > div:nth-child(5) { grid-column: span 3; }
.metodo-grade h3 { font-size: clamp(21px, 2vw, 25px); }
.metodo-grade p { color: var(--tinta-2); font-size: 16px; }
.paginas { margin-top: clamp(48px, 6vw, 72px); }
.paginas .rotulo { display: block; margin-bottom: 18px; }
.trilho { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 4px 22px; margin: 0 -4px; scrollbar-color: var(--tinta-2) transparent; }
.trilho figure { flex: 0 0 clamp(220px, 26vw, 290px); margin: 0; scroll-snap-align: start; }
.trilho img { width: 100%; height: auto; box-shadow: 0 14px 30px -14px rgba(30, 26, 20, .45), 0 0 0 1px var(--linha-papel); background: #fff; }
.trilho figcaption { margin-top: 12px; font: 500 12px/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--tinta-2); }

/* ── a coleção ─────────────────────────────────────────── */
.colecao-grade { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: 20px; }
.dossie { background: var(--noir-2); border: 1px solid var(--linha); border-radius: 6px; overflow: hidden; }
.dossie.principal { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
.dossie .capa { background: #0E0C09; padding: 28px; display: grid; place-items: center; border-right: 1px solid var(--linha); }
.dossie .capa img { width: 100%; max-width: 300px; box-shadow: 0 20px 40px -18px rgba(0, 0, 0, .8); transform: rotate(-2deg); }
.dossie .corpo { padding: clamp(24px, 3vw, 36px); display: grid; gap: 16px; align-content: start; }
.dossie h3 { font-size: clamp(28px, 3vw, 38px); }
.dossie .sub { color: #D9D1C1; }
.estado { display: inline-flex; align-items: center; gap: 8px; width: max-content; font: 600 11px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; padding: 7px 11px; border-radius: 999px; border: 1px solid currentColor; }
.estado::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.estado.producao { color: var(--ouro); }
.estado.pesquisa { color: var(--cinza); }
.estado.gratis { color: #8FD19E; }
.pilha { list-style: none; margin: 4px 0 0; padding: 0; border-top: 1px solid var(--linha); }
.pilha li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--linha); font-size: 15px; }
.pilha li span { font: 400 13px/1.6 var(--mono); color: var(--cinza); font-variant-numeric: tabular-nums; white-space: nowrap; }
.preco { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.preco strong { font: 900 34px/1 var(--display); }
.preco small { color: var(--cinza); font-size: 14px; }
.dossie .captura { max-width: none; grid-template-columns: minmax(0, 1fr); }
.dossie .captura .botao { width: 100%; }
.dossie.data { display: grid; align-content: space-between; gap: 28px; padding: clamp(24px, 3vw, 36px); background:
  linear-gradient(180deg, rgba(255, 191, 0, .06), transparent 45%), var(--noir-2); }
.dossie.data .dia { font: 900 clamp(48px, 5.6vw, 72px)/.95 var(--display); color: var(--papel); letter-spacing: -.02em; }
.dossie.data .dia small { display: block; font: 500 12px/1.3 var(--mono); letter-spacing: .14em; color: var(--ouro); margin-bottom: 14px; text-transform: uppercase; }
.dossie.data p { color: #D9D1C1; }
.dossie.data .nota { font: 400 13px/1.5 var(--mono); color: var(--cinza); }
.fatos { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linha); }
.fatos li { padding: 12px 0; border-bottom: 1px solid var(--linha); font-size: 15px; color: #D9D1C1; }
.fatos li b { display: block; font: 800 24px/1.15 var(--display); color: var(--papel); margin-bottom: 2px; }
.fatos cite { display: block; margin-top: 10px; font: 400 12px/1.5 var(--mono); font-style: normal; color: var(--cinza); }

/* ── as evidências ─────────────────────────────────────── */
.evidencias { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(28px, 5vw, 64px); border-top: 2px solid var(--tinta); }
.evidencia { padding: 26px 0 24px; border-bottom: 1px solid var(--linha-papel); display: grid; gap: 12px; }
.evidencia p:not(.rotulo) { font: 600 clamp(18px, 1.7vw, 20px)/1.45 var(--display); color: var(--tinta); }
.evidencia cite { font: 400 12px/1.5 var(--mono); font-style: normal; color: var(--tinta-2); }
.evidencia cite::before { content: "Fonte · "; color: var(--ouro-papel); font-weight: 500; }
html[lang="en"] .evidencia cite::before { content: "Source · "; }

/* ── os vídeos ─────────────────────────────────────────── */
.videos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
.video { text-decoration: none; display: grid; gap: 12px; }
.video .quadro { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 4px; background: var(--noir-3); box-shadow: 0 0 0 1px var(--linha); }
.video .quadro img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.video:hover .quadro img { transform: scale(1.04); }
.video:hover .quadro { box-shadow: 0 0 0 2px var(--ouro); }
.video:hover span { color: var(--ouro); }
.video b { font: 700 18px/1.3 var(--display); }
.video span { font: 400 12px/1.4 var(--mono); color: var(--cinza); letter-spacing: .04em; }

/* ── garantia e perguntas ──────────────────────────────── */
.garantia .wrap { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
.garantia .sete { font: 900 clamp(120px, 16vw, 220px)/.8 var(--display); color: var(--ouro); }
.garantia h2 { font-size: clamp(30px, 4vw, 48px); margin-bottom: 16px; }
.garantia p { color: #D9D1C1; max-width: 60ch; }
.duvidas { border-top: 1px solid var(--linha-papel); max-width: 860px; }
.duvidas details { border-bottom: 1px solid var(--linha-papel); }
.duvidas summary { list-style: none; cursor: pointer; padding: 22px 40px 22px 0; position: relative; font: 700 clamp(18px, 1.8vw, 21px)/1.35 var(--display); }
.duvidas summary::-webkit-details-marker { display: none; }
.duvidas summary::after { content: "+"; position: absolute; right: 4px; top: 18px; font: 400 26px/1 var(--texto); color: var(--ouro-papel); transition: transform .2s; }
.duvidas details[open] summary::after { transform: rotate(45deg); }
.duvidas details p { padding: 0 0 24px; color: var(--tinta-2); max-width: 68ch; }

/* ── fecho e rodapé ────────────────────────────────────── */
.fecho { text-align: left; }
.fecho h2 { font-size: clamp(36px, 5.4vw, 68px); max-width: 16ch; margin: 16px 0 20px; }
.fecho p.lead { color: var(--cinza); max-width: 56ch; margin-bottom: 30px; font-size: 18px; }
.rodape { border-top: 1px solid var(--linha); padding: 48px 0 56px; font-size: 14px; color: var(--cinza); }
.rodape .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 32px 48px; }
.rodape .tag { font: 600 12px/1.4 var(--mono); letter-spacing: .18em; margin-top: 12px; }
.rodape .tag.pt { color: var(--ouro); }
.rodape .tag.en { color: #FFFFFF; }
.rodape nav { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-bottom: 16px; }
.rodape nav a { color: var(--papel); text-decoration: none; }
.rodape nav a:hover { text-decoration: underline; }
.rodape .legal { font-size: 13px; line-height: 1.6; max-width: 72ch; }

/* ── amostra: aviso visível só nesta fase ──────────────── */
.faixa-amostra { background: var(--ouro); color: var(--noir); font: 600 12px/1.3 var(--mono); letter-spacing: .06em; text-align: center; padding: 8px 16px; }

/* ── entrada (respeita quem pede menos movimento) ──────── */
@media (prefers-reduced-motion: no-preference) {
  .pasta figure { animation: abre 1s cubic-bezier(.2, .7, .2, 1) both; }
  .pasta .fundo { animation-delay: .1s; }
  .pasta .frente { animation-delay: .28s; }
  .pasta .etiqueta { animation: abre .8s .6s cubic-bezier(.2, .7, .2, 1) both; }
  .revela { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
  .revela.vista { opacity: 1; transform: none; }
}
@keyframes abre { from { opacity: 0; translate: 0 26px; } to { opacity: 1; translate: 0 0; } }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

/* ── telas menores ─────────────────────────────────────── */
@media (max-width: 960px) {
  .nav { display: none; }
  .idioma { margin-left: auto; }
  .hero .wrap, .ficha .wrap, .colecao-grade, .dossie.principal { grid-template-columns: minmax(0, 1fr); }
  .pasta { max-width: 460px; width: 100%; margin: 8px auto 0; }
  .dossie .capa { border-right: 0; border-bottom: 1px solid var(--linha); }
  .dossie .capa img { max-width: 260px; }
  .videos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .metodo-grade > div, .metodo-grade > div:nth-child(4), .metodo-grade > div:nth-child(5) { grid-column: span 3; }
  .metodo-grade > div:nth-child(5) { grid-column: 1 / -1; }
}
@media (max-width: 640px) {
  body { font-size: 16px; }
  .topo .wrap { height: 58px; }
  .marca small { display: none; }
  .captura { grid-template-columns: minmax(0, 1fr); }
  .botao { width: 100%; }
  .numeros .wrap { grid-template-columns: minmax(0, 1fr); }
  .numero { border-left: 0; border-top: 1px solid var(--linha); padding-left: 0; padding-right: 0; }
  .numero:first-child { border-top: 0; }
  .metodo-grade { grid-template-columns: minmax(0, 1fr); }
  .metodo-grade > div, .metodo-grade > div:nth-child(4), .metodo-grade > div:nth-child(5) { grid-column: 1 / -1; }
  .evidencias, .videos { grid-template-columns: minmax(0, 1fr); }
  .garantia .wrap { grid-template-columns: minmax(0, 1fr); }
  .garantia .sete { font-size: 120px; }
  .rodape .wrap { grid-template-columns: minmax(0, 1fr); }
  .perguntas li { grid-template-columns: 48px minmax(0, 1fr); }
  .perguntas li::before { font-size: 28px; }
}

.aviso-amostra { position: fixed; left: 50%; bottom: 96px; z-index: 50; transform: translate(-50%, 20px); opacity: 0; pointer-events: none; transition: .3s; max-width: calc(100vw - 32px); background: var(--ouro); color: var(--noir); font: 600 13px/1.4 var(--mono); padding: 12px 16px; border-radius: 4px; box-shadow: 0 10px 30px rgba(0,0,0,.4); }
.aviso-amostra.vista { opacity: 1; transform: translate(-50%, 0); }
.rodape .vendedor { margin-top: 8px; }
.pendente { background: rgba(255, 191, 0, .16); color: var(--ouro-claro); padding: 0 6px; border-radius: 3px; font-family: var(--mono); font-size: 12px; }
